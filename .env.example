PROJECT_NAME="Roommate Match App"
DATABASE_URL=postgresql://roommate_user:roommate_password@localhost:5432/roommate_db
# Обязательно задайте свой секрет. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-please-set-a-strong-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=43200
# Источники для CORS: через запятую или JSON-массивом
CORS_ORIGINS=http://localhost:5173
# Загрузка файлов
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880
# Лимит запросов на IP в минуту (0 — отключено)
RATE_LIMIT_PER_MINUTE=120